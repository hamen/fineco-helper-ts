{
  "name": "fineco-helper",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only Fineco portfolio helper that exports JSON, CSV, and an HTML report.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npm run build --silent && node dist/fineco-portfolio.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write fineco-portfolio.ts README.md package.json tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
