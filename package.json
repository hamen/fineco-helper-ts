{
  "name": "fineco-helper",
  "version": "0.1.0",
  "private": true,
  "description": "Local-only Fineco portfolio helper that exports JSON, CSV, and an HTML report.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npm run build --silent && node dist/fineco-portfolio.js",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx --test tests/*.test.ts",
    "format": "prettier --write enrichment.ts fineco-portfolio.ts fineco-mcp.ts mcp-server.ts mcp-http-server.ts tests/*.test.ts README.md package.json tsconfig.json",
    "mcp": "npm run build --silent && node dist/mcp-server.js",
    "mcp:http": "npm run build --silent && node dist/mcp-http-server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
