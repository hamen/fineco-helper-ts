{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "enrichment.ts",
    "fineco-portfolio.ts",
    "fineco-mcp.ts",
    "mcp-server.ts",
    "mcp-http-server.ts",
    "tests/*.test.ts"
  ]
}
